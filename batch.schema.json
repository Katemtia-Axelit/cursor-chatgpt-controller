{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursor-controller-batch-v0.schema.json",
  "title": "Cursor Controller Batch v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "workers"],
  "properties": {
    "schema_version": { "const": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["envelope", "depends_on", "write_scope"],
        "properties": {
          "envelope": { "type": "string", "minLength": 1 },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 8 },
            "uniqueItems": true
          },
          "write_scope": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
