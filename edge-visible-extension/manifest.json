{
  "manifest_version": 3,
  "name": "Controller Loop Visible Background Bridge",
  "version": "0.3.4",
  "description": "Background messages to one designated ChatGPT project chat.",
  "action": {
    "default_title": "Controller Loop 状态",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://127.0.0.1:37951/*",
    "https://chatgpt.com/*"
  ],
  "permissions": [
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
